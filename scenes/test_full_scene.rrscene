{
  "version": "1.0.0",

  "render_settings": {
    "width":             1280,
    "height":            720,
    "samples_per_pixel": 1,
    "max_depth":         1,
    "output_path":       "output/full_scene.ppm"
  },

  "camera": {
    "position":    [0.0, 0.5, 3.0],
    "forward":     [0.0, -0.1, -1.0],
    "up":          [0.0, 1.0, 0.0],
    "fovDegrees":  50.0
  },

  "relativity": {
    "enabled":             true,
    "betaVelocity":        0.30,
    "velocityDirection":   [0.0, 0.0, -1.0],
    "aberrationStrength":  1.0,
    "dopplerStrength":     1.0,
    "searchlightStrength": 1.0
  },

  "materials": [
    { "id": 0, "name": "red",      "baseColor": [0.85, 0.20, 0.20] },
    { "id": 1, "name": "green",    "baseColor": [0.20, 0.80, 0.30] },
    { "id": 2, "name": "blue",     "baseColor": [0.20, 0.30, 0.90] },
    { "id": 3, "name": "emissive",
      "baseColor":        [0.10, 0.10, 0.10],
      "emissionColor":    [1.00, 0.85, 0.35],
      "emissionStrength": 2.0 },
    { "id": 4, "name": "neutral",  "baseColor": [0.65, 0.65, 0.65] }
  ],

  "spheres": [
    { "name": "left",        "center": [-1.5,  0.2, -4.0], "radius": 0.7, "materialId": 0 },
    { "name": "centre",      "center": [ 0.0, -0.1, -3.5], "radius": 0.8, "material_index": 1 },
    { "name": "right",       "center": [ 1.5,  0.2, -4.0], "radius": 0.7, "materialId": 2 },
    { "name": "ground-bulb", "center": [ 0.0, -1.4, -5.0], "radius": 1.0, "materialId": 3 }
  ],

  "meshes": [
    {
      "name":       "ground-quad",
      "materialId": 4,
      "vertices": [
        { "position": [-3.0, -3.0, -6.0], "normal": [0.0, 0.0, 1.0], "uv": [0.0, 0.0] },
        { "position": [ 3.0, -3.0, -6.0], "normal": [0.0, 0.0, 1.0], "uv": [1.0, 0.0] },
        { "position": [ 3.0,  3.0, -6.0], "normal": [0.0, 0.0, 1.0], "uv": [1.0, 1.0] },
        { "position": [-3.0,  3.0, -6.0], "normal": [0.0, 0.0, 1.0], "uv": [0.0, 1.0] }
      ],
      "triangles": [
        [0, 1, 2],
        [0, 2, 3]
      ]
    }
  ],

  "lights": [
    { "type": "directional", "name": "key",
      "direction": [-0.4, -0.7, -0.6],
      "color":     [1.00, 0.95, 0.85],
      "intensity": 0.9 },
    { "type": "point",       "name": "fill",
      "position":  [2.0, 1.5, -2.5],
      "color":     [1.00, 0.85, 0.60],
      "intensity": 30.0 },
    { "type": "environment", "name": "sky",
      "color":     [0.30, 0.40, 0.55],
      "intensity": 0.4 }
  ]
}
